#!/usr/bin/env bash
set -euo pipefail
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$ROOT_DIR/scripts/port_guard.sh"
source "$ROOT_DIR/scripts/runtime_config_lib.sh"

CONFIG_SERVER_PORT="$(runtime_read_config_value "$ROOT_DIR" "server_port" "8120")"
CONFIG_BRIDGE_PORT="$(runtime_read_config_value "$ROOT_DIR" "bridge_port" "8121")"
PORT="${1:-$CONFIG_SERVER_PORT}"

validate_sinet_port "$PORT"
validate_sinet_port "$CONFIG_BRIDGE_PORT"

"$ROOT_DIR/scripts/start_runtime_bridge.sh"
sleep 1
"$ROOT_DIR/scripts/start_shell_server.sh" "$PORT"

echo "SINET runtime ready."
echo "Server : http://127.0.0.1:${PORT}/"
echo "Bridge : http://127.0.0.1:${CONFIG_BRIDGE_PORT}/api/health"
