#!/usr/bin/env python3
import argparse
import json
import os
import signal
import socket
import subprocess
import sys
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import urlparse

ROOT = Path(__file__).resolve().parents[1]
STATE_FILE = ROOT / "data" / "runtime" / "server_control_state.json"
AUDIT_FILE = ROOT / "audit.log"
CONFIG_FILE = ROOT / "server" / "runtime.config.json"
DEFAULT_SERVER_PORT = 8120
DEFAULT_BRIDGE_PORT = 8121
MIN_ALLOWED_PORT = 8120
MAX_ALLOWED_PORT = 8180
READINESS_TIMEOUT_SEC = 5.0
CURRENT_BRIDGE_PORT = DEFAULT_BRIDGE_PORT
SAFE_SCRIPT_NAMES = {
    "start.sh": {"args": True},
    "start_runtime_bridge.sh": {"args": False},
    "start_shell_server.sh": {"args": True},
    "restart_shell_server.sh": {"args": True},
    "stop_shell_server.sh": {"args": False},
    "status_shell_server.sh": {"args": False},
}


def now_iso():
    from datetime import datetime, timezone
    return datetime.now(timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z")


def detect_ip():
    ip = "127.0.0.1"
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect(("8.8.8.8", 80))
        ip = s.getsockname()[0]
        s.close()
    except Exception:
        pass
    return ip


def validate_port(port):
    try:
        value = int(port)
    except Exception as exc:
        raise ValueError(f"Port mora biti ceo broj u opsegu {MIN_ALLOWED_PORT}-{MAX_ALLOWED_PORT}.") from exc
    if value < MIN_ALLOWED_PORT or value > MAX_ALLOWED_PORT:
        raise ValueError(f"Dozvoljen je samo port u opsegu {MIN_ALLOWED_PORT}-{MAX_ALLOWED_PORT}.")
    return value


def validate_distinct_ports(server_port, bridge_port):
    if int(server_port) == int(bridge_port):
        raise ValueError("Server i bridge moraju koristiti različite portove.")
    return True


def local_url(port):
    return f"http://127.0.0.1:{int(port)}/"


def lan_url(port):
    return f"http://{detect_ip()}:{int(port)}/"


def is_port_open(host, port, timeout=0.35):
    try:
        with socket.create_connection((host, int(port)), timeout=timeout):
            return True
    except Exception:
        return False


def wait_for_server_ready(port, pid=None, timeout=READINESS_TIMEOUT_SEC):
    deadline = time.time() + timeout
    while time.time() < deadline:
        if pid and not is_pid_running(pid):
            return False
        if is_port_open("127.0.0.1", port):
            return True
        time.sleep(0.2)
    return is_port_open("127.0.0.1", port)


def append_audit(action, detail):
    AUDIT_FILE.parent.mkdir(parents=True, exist_ok=True)
    with AUDIT_FILE.open("a", encoding="utf-8") as fh:
        fh.write(f"{now_iso()} | sinet-runtime | {action} | {detail}\n")


def default_config():
    return {
        "project_name": ROOT.name,
        "host": "127.0.0.1",
        "server_port": DEFAULT_SERVER_PORT,
        "bridge_port": DEFAULT_BRIDGE_PORT,
        "port_range_start": MIN_ALLOWED_PORT,
        "port_range_end": MAX_ALLOWED_PORT,
        "auto_open_browser": True,
        "preferred_start_page": "index.html",
        "profile_version": "1.0",
        "notes": "Runtime profile auto-generated by SINET Serve standard."
    }


def load_config():
    data = default_config()
    if CONFIG_FILE.exists():
        try:
            raw = json.loads(CONFIG_FILE.read_text(encoding="utf-8"))
            if isinstance(raw, dict):
                data.update(raw)
        except Exception:
            pass
    data["server_port"] = validate_port(data.get("server_port", DEFAULT_SERVER_PORT))
    data["bridge_port"] = validate_port(data.get("bridge_port", DEFAULT_BRIDGE_PORT))
    validate_distinct_ports(data["server_port"], data["bridge_port"])
    data["port_range_start"] = MIN_ALLOWED_PORT
    data["port_range_end"] = MAX_ALLOWED_PORT
    data["project_name"] = data.get("project_name") or ROOT.name
    data["host"] = data.get("host") or "127.0.0.1"
    data["preferred_start_page"] = data.get("preferred_start_page") or "index.html"
    data["auto_open_browser"] = bool(data.get("auto_open_browser", True))
    return data


def save_config(payload):
    current = load_config()
    new_data = {**current}
    allowed_keys = {
        "project_name",
        "host",
        "server_port",
        "bridge_port",
        "auto_open_browser",
        "preferred_start_page",
        "profile_version",
        "notes",
    }
    for key in allowed_keys:
        if key in payload:
            new_data[key] = payload[key]
    new_data["server_port"] = validate_port(new_data.get("server_port", DEFAULT_SERVER_PORT))
    new_data["bridge_port"] = validate_port(new_data.get("bridge_port", DEFAULT_BRIDGE_PORT))
    validate_distinct_ports(new_data["server_port"], new_data["bridge_port"])
    new_data["host"] = str(new_data.get("host") or "127.0.0.1")
    new_data["project_name"] = str(new_data.get("project_name") or ROOT.name)
    new_data["preferred_start_page"] = str(new_data.get("preferred_start_page") or "index.html")
    new_data["auto_open_browser"] = bool(new_data.get("auto_open_browser", True))
    new_data["profile_version"] = str(new_data.get("profile_version") or "1.0")
    CONFIG_FILE.parent.mkdir(parents=True, exist_ok=True)
    CONFIG_FILE.write_text(json.dumps(new_data, ensure_ascii=False, indent=2), encoding="utf-8")
    append_audit("save-config", f"server_port={new_data['server_port']};bridge_port={new_data['bridge_port']}")
    state = refresh_state_status(read_state())
    state["server_port"] = new_data["server_port"]
    state["updated_at"] = now_iso()
    save_state(state)
    return new_data


def save_state(state):
    STATE_FILE.parent.mkdir(parents=True, exist_ok=True)
    STATE_FILE.write_text(json.dumps(state, ensure_ascii=False, indent=2), encoding="utf-8")


def ensure_state():
    if not STATE_FILE.exists():
        cfg = load_config()
        save_state({
            "shell_version": "1.2.0",
            "status": "STOPPED",
            "server_port": cfg["server_port"],
            "ip_address": detect_ip(),
            "pid": None,
            "message": "Bridge initialized.",
            "last_action": "init",
            "updated_at": now_iso(),
            "bridge_port": CURRENT_BRIDGE_PORT,
            "bridge_reachable": True,
            "allowed_port_min": MIN_ALLOWED_PORT,
            "allowed_port_max": MAX_ALLOWED_PORT,
        })


def read_state():
    ensure_state()
    state = json.loads(STATE_FILE.read_text(encoding="utf-8"))
    cfg = load_config()
    state.setdefault("shell_version", "1.2.0")
    state.setdefault("server_port", cfg["server_port"])
    state.setdefault("bridge_port", CURRENT_BRIDGE_PORT)
    state.setdefault("bridge_reachable", True)
    state.setdefault("allowed_port_min", MIN_ALLOWED_PORT)
    state.setdefault("allowed_port_max", MAX_ALLOWED_PORT)
    return state


def is_pid_running(pid):
    if not pid:
        return False
    try:
        os.kill(int(pid), 0)
        return True
    except Exception:
        return False


def runtime_snapshot():
    cfg = load_config()
    restart_bridge_required = int(cfg["bridge_port"]) != int(CURRENT_BRIDGE_PORT)
    return {
        "config": cfg,
        "project_name": cfg["project_name"],
        "config_server_port": cfg["server_port"],
        "config_bridge_port": cfg["bridge_port"],
        "current_bridge_port": CURRENT_BRIDGE_PORT,
        "restart_bridge_required": restart_bridge_required,
        "config_file": str(CONFIG_FILE.relative_to(ROOT)),
    }


def enrich_state(state):
    cfg = load_config()
    port = int(state.get("server_port") or cfg["server_port"])
    ip = detect_ip()
    state["shell_version"] = state.get("shell_version") or "1.2.0"
    state["version"] = state["shell_version"]
    state["server_port"] = port
    state["managed_port"] = port
    state["ip_address"] = ip
    state["managed_local_url"] = local_url(port)
    state["managed_lan_url"] = lan_url(port)
    state["bridge_port"] = CURRENT_BRIDGE_PORT
    state["bridge_reachable"] = True
    state["allowed_port_min"] = MIN_ALLOWED_PORT
    state["allowed_port_max"] = MAX_ALLOWED_PORT
    state["pid_running"] = is_pid_running(state.get("pid"))
    state["server_reachable"] = is_port_open("127.0.0.1", port)
    state.update(runtime_snapshot())
    return state


def refresh_state_status(state=None):
    state = state or read_state()
    state = enrich_state(state)
    if state.get("status") == "RUN":
        if not state["pid_running"]:
            state["status"] = "NOT_WORKING"
            state["message"] = "Process not running."
            state["pid"] = None
            state["updated_at"] = now_iso()
            save_state(state)
        elif not state["server_reachable"]:
            state["status"] = "NOT_WORKING"
            state["message"] = "Process exists but server port is not responding."
            state["updated_at"] = now_iso()
            save_state(state)
    elif state.get("status") == "STOPPED":
        state["server_reachable"] = False
    return enrich_state(state)


def stop_server():
    state = read_state()
    pid = state.get("pid")
    if pid and is_pid_running(pid):
        try:
            os.killpg(os.getpgid(int(pid)), signal.SIGTERM)
        except Exception:
            try:
                os.kill(int(pid), signal.SIGTERM)
            except Exception:
                pass

        deadline = time.time() + 3
        while time.time() < deadline and is_pid_running(pid):
            time.sleep(0.1)

        if is_pid_running(pid):
            try:
                os.killpg(os.getpgid(int(pid)), signal.SIGKILL)
            except Exception:
                try:
                    os.kill(int(pid), signal.SIGKILL)
                except Exception:
                    pass

        state["status"] = "STOPPED"
        state["message"] = "Server stopped."
        state["pid"] = None
        state["updated_at"] = now_iso()
        state["last_action"] = "stop"
        save_state(state)
        append_audit("stop", f"port={state.get('server_port')}")
        return {"ok": True, **refresh_state_status(state)}

    state["status"] = "STOPPED"
    state["message"] = "Server already stopped."
    state["pid"] = None
    state["updated_at"] = now_iso()
    state["last_action"] = "stop-noop"
    save_state(state)
    return {"ok": True, **refresh_state_status(state)}


def start_server(port=None):
    cfg = load_config()
    port = validate_port(port or cfg["server_port"])
    state = refresh_state_status(read_state())
    pid = state.get("pid")
    if pid and state.get("status") == "RUN" and state.get("server_port") == port and is_pid_running(pid) and is_port_open("127.0.0.1", port):
        state["message"] = "Server already running."
        save_state(state)
        return {"ok": True, **refresh_state_status(state)}

    if is_port_open("127.0.0.1", port):
        state["status"] = "NOT_WORKING"
        state["server_port"] = port
        state["pid"] = None
        state["message"] = f"Port {port} je već zauzet drugim procesom."
        state["updated_at"] = now_iso()
        state["last_action"] = "start-blocked"
        save_state(state)
        append_audit("start-blocked", f"port={port};reason=port-in-use")
        return {"ok": False, **refresh_state_status(state)}

    cmd = [sys.executable, "-m", "http.server", str(port), "--bind", "0.0.0.0", "--directory", str(ROOT)]
    proc = subprocess.Popen(
        cmd,
        cwd=str(ROOT),
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )

    state["status"] = "RUN"
    state["server_port"] = port
    state["ip_address"] = detect_ip()
    state["pid"] = proc.pid
    state["message"] = "Server starting..."
    state["updated_at"] = now_iso()
    state["last_action"] = "start"
    save_state(state)
    append_audit("start", f"port={port};pid={proc.pid}")

    ready = wait_for_server_ready(port, pid=proc.pid)
    if ready:
        state["status"] = "RUN"
        state["message"] = "Server running and reachable."
        state["updated_at"] = now_iso()
        save_state(state)
        return {"ok": True, **refresh_state_status(state)}

    state["status"] = "NOT_WORKING"
    state["message"] = f"Server process started but port {port} did not become reachable."
    if not is_pid_running(proc.pid):
        state["pid"] = None
        state["message"] = f"Server failed to stay running on port {port}."
    state["updated_at"] = now_iso()
    save_state(state)
    append_audit("start-failed", f"port={port};pid={proc.pid}")
    return {"ok": False, **refresh_state_status(state)}


def restart_server(port=None):
    cfg = load_config()
    port = validate_port(port or cfg["server_port"])
    stop_server()
    time.sleep(0.2)
    return start_server(port)


def set_port(port):
    port = validate_port(port)
    cfg = save_config({"server_port": port})
    state = refresh_state_status(read_state())
    was_running = bool(state.get("pid") and is_pid_running(state.get("pid")) and state.get("status") == "RUN")
    state["server_port"] = cfg["server_port"]
    state["ip_address"] = detect_ip()
    state["updated_at"] = now_iso()
    state["last_action"] = "set-port"
    state["message"] = f"Server port set to {port}."
    save_state(state)
    append_audit("set-port", f"port={port}")
    if was_running:
        return restart_server(port)
    return {"ok": True, **refresh_state_status(read_state())}


def run_allowed_script(script_name, port=None):
    if script_name not in SAFE_SCRIPT_NAMES:
        raise ValueError(f"Script not allowed: {script_name}")

    script_path = ROOT / "scripts" / script_name
    if not script_path.exists():
        raise FileNotFoundError(f"Script not found: {script_name}")

    cmd = ["bash", str(script_path)]
    if SAFE_SCRIPT_NAMES[script_name].get("args"):
        cfg = load_config()
        cmd.append(str(validate_port(port or cfg["server_port"])))

    proc = subprocess.run(
        cmd,
        cwd=str(ROOT),
        capture_output=True,
        text=True,
        timeout=25,
        env={**os.environ, "PYTHONUNBUFFERED": "1"},
    )
    append_audit("run-script", f"script={script_name};code={proc.returncode}")
    state = refresh_state_status(read_state())
    return {
        "ok": proc.returncode == 0,
        "script": script_name,
        "exit_code": proc.returncode,
        "stdout": (proc.stdout or "").strip(),
        "stderr": (proc.stderr or "").strip(),
        "state": state,
    }


def scan_ports():
    cfg = load_config()
    ports = []
    for port in range(MIN_ALLOWED_PORT, MAX_ALLOWED_PORT + 1):
        ports.append({
            "port": port,
            "in_use": is_port_open("127.0.0.1", port),
            "reserved_for": (
                "server" if port == int(cfg["server_port"]) else
                "bridge" if port == int(cfg["bridge_port"]) else
                ""
            )
        })
    return {
        "ok": True,
        "range": [MIN_ALLOWED_PORT, MAX_ALLOWED_PORT],
        "ports": ports,
        **runtime_snapshot(),
    }


def suggest_ports(limit=5):
    cfg = load_config()
    scan = scan_ports()["ports"]
    in_use = {item["port"] for item in scan if item["in_use"]}
    suggestions = []

    for server_port in range(MIN_ALLOWED_PORT, MAX_ALLOWED_PORT):
        bridge_port = server_port + 1
        if bridge_port > MAX_ALLOWED_PORT:
            continue
        if server_port in in_use or bridge_port in in_use:
            continue
        suggestions.append({
            "server_port": server_port,
            "bridge_port": bridge_port,
            "pattern": "adjacent",
            "recommended": server_port == int(cfg["server_port"]) and bridge_port == int(cfg["bridge_port"]),
        })
        if len(suggestions) >= limit:
            break

    if len(suggestions) < limit:
        free_ports = [item["port"] for item in scan if not item["in_use"]]
        for server_port in free_ports:
            for bridge_port in free_ports:
                if bridge_port == server_port:
                    continue
                pair = {"server_port": server_port, "bridge_port": bridge_port, "pattern": "free-pair", "recommended": False}
                if pair not in suggestions:
                    suggestions.append(pair)
                if len(suggestions) >= limit:
                    break
            if len(suggestions) >= limit:
                break

    return {
        "ok": True,
        "suggestions": suggestions[:limit],
        **runtime_snapshot(),
    }


class Handler(BaseHTTPRequestHandler):
    def _json(self, payload, status=200):
        data = json.dumps(payload, ensure_ascii=False).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Methods", "GET, POST, OPTIONS")
        self.send_header("Access-Control-Allow-Headers", "Content-Type")
        self.end_headers()
        self.wfile.write(data)

    def do_OPTIONS(self):
        self._json({"ok": True})

    def do_GET(self):
        path = urlparse(self.path).path.rstrip("/") or "/"
        if path in {"/status", "/api/status", "/api/runtime/status"}:
            state = refresh_state_status()
            self._json({**state, "ok": state.get("status") in {"RUN", "STOPPED"}})
            return
        if path in {"/health", "/api/health", "/api/runtime/health"}:
            snap = runtime_snapshot()
            self._json({
                "ok": True,
                "bridge_reachable": True,
                "bridge_port": CURRENT_BRIDGE_PORT,
                "allowed_port_min": MIN_ALLOWED_PORT,
                "allowed_port_max": MAX_ALLOWED_PORT,
                **snap,
            })
            return
        if path in {"/api/runtime/config"}:
            self._json({"ok": True, **runtime_snapshot()})
            return
        if path in {"/api/runtime/scan-ports"}:
            self._json(scan_ports())
            return
        if path in {"/api/runtime/suggest-ports"}:
            self._json(suggest_ports())
            return
        self._json({"ok": False, "message": "Not found.", "path": path}, status=404)

    def do_POST(self):
        path = urlparse(self.path).path.rstrip("/") or "/"
        length = int(self.headers.get("Content-Length") or 0)
        body = self.rfile.read(length) if length else b"{}"
        try:
            payload = json.loads(body.decode("utf-8") or "{}")
        except Exception:
            payload = {}

        try:
            if path in {"/api/start", "/api/runtime/start"}:
                result = start_server(payload.get("port"))
                self._json(result, status=200 if result.get("ok") else 409)
                return
            if path in {"/api/stop", "/api/runtime/stop"}:
                self._json(stop_server())
                return
            if path in {"/api/restart", "/api/runtime/restart"}:
                result = restart_server(payload.get("port"))
                self._json(result, status=200 if result.get("ok") else 409)
                return
            if path in {"/api/set-port", "/api/runtime/set-port", "/api/runtime/port"}:
                result = set_port(payload.get("port"))
                self._json(result, status=200 if result.get("ok") else 409)
                return
            if path in {"/api/runtime/run-script", "/api/run-script"}:
                result = run_allowed_script(payload.get("script"), payload.get("port"))
                self._json(result, status=200 if result.get("ok") else 409)
                return
            if path in {"/api/runtime/config"}:
                cfg = save_config(payload or {})
                self._json({"ok": True, **runtime_snapshot(), "message": "Runtime config saved.", "saved_config": cfg})
                return
            self._json({"ok": False, "message": "Not found.", "path": path}, status=404)
        except Exception as exc:
            self._json({"ok": False, "message": f"Runtime error: {exc}"}, status=500)

    def log_message(self, fmt, *args):
        return


def parse_args():
    parser = argparse.ArgumentParser(description="SINET runtime control bridge")
    parser.add_argument("--port", type=int, default=None, help="Bridge port override")
    return parser.parse_args()


if __name__ == "__main__":
    args = parse_args()
    cfg = load_config()
    bridge_port = args.port if args.port is not None else cfg["bridge_port"]
    bridge_port = validate_port(bridge_port)
    CURRENT_BRIDGE_PORT = bridge_port
    ensure_state()
    server = ThreadingHTTPServer(("127.0.0.1", CURRENT_BRIDGE_PORT), Handler)
    append_audit("bridge-start", f"bridge_port={CURRENT_BRIDGE_PORT}")
    print(f"SINET runtime bridge on http://127.0.0.1:{CURRENT_BRIDGE_PORT}")
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
